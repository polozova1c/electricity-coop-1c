
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    // Значения по умолчанию — ваш случай: 0, 1, 3, 5, ..., 43; ввод №1
    Префикс = "№ ";
    НомерНачало = 1;
    НомерКонец = 43;
    Шаг = 2;
    ДополнительныеНомера = "0";
    Ввод = Справочники.ВводыЭлектроснабжения.НайтиПоНаименованию("Ввод № 1");
    Если Ввод.Пустая() Тогда
        Сообщить("Ввод «Ввод № 1» не найден — выберите ввод на форме вручную.");
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьБоксы(Команда)
    СоздатьБоксыНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьБоксыНаСервере()
    // ---------- 1. Проверки ----------
    Если Ввод.Пустая() Тогда
        Сообщить("Укажите ввод — он будет присвоен всем создаваемым боксам.");
        Возврат;
    КонецЕсли;
    Если ПустаяСтрока(Префикс) Тогда
        Сообщить("Укажите префикс наименования (например, «Бокс № »).");
        Возврат;
    КонецЕсли;
    Если Шаг <= 0 Тогда
        Сообщить("Шаг должен быть больше нуля."); // иначе цикл не закончится
        Возврат;
    КонецЕсли;
    Если НомерКонец < НомерНачало Тогда
        Сообщить("Конечный номер меньше начального.");
        Возврат;
    КонецЕсли;

    // ---------- 2. Собираем номера ----------
    Номера = Новый Массив;

    // дополнительные номера через запятую: "0" или "0, 45, 100"
    Если НЕ ПустаяСтрока(ДополнительныеНомера) Тогда
        Части = СтрРазделить(ДополнительныеНомера, ",", Ложь);
        Для Каждого Часть Из Части Цикл
            НомСтр = СокрЛП(Часть);
            Если НомСтр = "" Тогда
                Продолжить;
            КонецЕсли;
            Попытка
                Ном = Число(НомСтр);
            Исключение
                Сообщить("Не удалось распознать номер: """ + НомСтр + """ — пропущен.");
                Продолжить;
            КонецПопытки;
            Если Номера.Найти(Ном) = Неопределено Тогда
                Номера.Добавить(Ном);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    // диапазон: от НомерНачало до НомерКонец с шагом
    Ном = НомерНачало;
    Пока Ном <= НомерКонец Цикл
        Если Номера.Найти(Ном) = Неопределено Тогда
            Номера.Добавить(Ном);
        КонецЕсли;
        Ном = Ном + Шаг;
    КонецЦикла;

    Если Номера.Количество() = 0 Тогда
        Сообщить("Список номеров пуст — проверьте параметры.");
        Возврат;
    КонецЕсли;

    // ---------- 3. Создание ----------
    Создано = 0;
    УжеБыло = 0;
    Для Каждого Ном Из Номера Цикл
        // ЧГ=0 — без разделителей разрядов (иначе номер 1023 даст «Бокс № 1 023»)
        Наименование = Префикс + Формат(Ном, "ЧГ=0");

        Существующий = Справочники.ГаражныеБоксы.НайтиПоНаименованию(Наименование, Истина);
        Если НЕ Существующий.Пустая() Тогда
            Сообщить("«" + Наименование + "» уже существует — пропущен.");
            УжеБыло = УжеБыло + 1;
            Продолжить;
        КонецЕсли;

        НовыйБокс = Справочники.ГаражныеБоксы.СоздатьЭлемент();
        НовыйБокс.Наименование = Наименование;
        НовыйБокс.Ввод = Ввод;
        НовыйБокс.Записать();
        Создано = Создано + 1;
    КонецЦикла;

    Сообщить("Готово. Создано: " + Создано + ". Уже существовало: " + УжеБыло
        + ". Всего номеров в списке: " + Номера.Количество() + ".");
	КонецПроцедуры 
	
	&НаКлиенте
Процедура ПереименоватьБоксы(Команда)
    Ответ = Вопрос("Переименовать все боксы вида «Бокс № X» в «№ X»?"
        + Символы.ПС + "Существующие номерные не трогаются.",
        РежимДиалогаВопрос.ДаНет);
    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    ПереименоватьБоксыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПереименоватьБоксыНаСервере()
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |	ГаражныеБоксы.Ссылка КАК Ссылка
    |ИЗ
    |	Справочник.ГаражныеБоксы КАК ГаражныеБоксы
    |ГДЕ
    |	ГаражныеБоксы.Наименование ПОДОБНО ""Бокс № %""";
    Выборка = Запрос.Выполнить().Выбрать();

    Переименовано = 0;
    Пока Выборка.Следующий() Цикл
        Старое = Выборка.Ссылка.Наименование;        // "Бокс № 12"
        НомерЧасть = СтрЗаменить(Старое, "Бокс № ", "№ "); // "№ 12" (и это уже нужное наименование)
        Новое = СокрЛП(НомерЧасть);

        // защита от коллизии: боксы «№ 12» уже может существовать
        Дубль = Справочники.ГаражныеБоксы.НайтиПоНаименованию(Новое, Истина);
        Если НЕ Дубль.Пустая() И Дубль <> Выборка.Ссылка Тогда
            Сообщить("«" + Старое + "»: бокс «" + Новое + "» уже существует — пропущен, разрулите вручную.");
            Продолжить;
        КонецЕсли;

        ОбъектБ = Выборка.Ссылка.ПолучитьОбъект();
        ОбъектБ.Наименование = Новое;
        ОбъектБ.Записать();
        Переименовано = Переименовано + 1;
    КонецЦикла;

    Сообщить("Переименовано: " + Переименовано + ".");
КонецПроцедуры