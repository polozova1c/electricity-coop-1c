
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаПлатежа = ТекущаяДатаСеанса();
КонецПроцедуры


&НаКлиенте
Процедура СоздатьДокументы(Команда)
	Если Объект.Платежи.Количество() = 0 Тогда
		Сообщить("Таблица пуста.");
	    Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("СоздатьДокументыЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Создать и провести " + Объект.Платежи.Количество() + " документов ""Поступление платежа"" от " + Формат(ДатаПлатежа,"ДЛФ=D") + "?",
	РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
 Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
 	СоздатьДокументыНаСервере();
 КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыНаСервере()
	Создано = 0;
	Ошибки = 0;
	Для каждого Стр Из Объект.Платежи Цикл
	   Если Стр.Бокс.Пустая() Или Стр.Сумма <= 0 Тогда
	   	Сообщить("Строка " + Стр.НомерСтроки + ": не заполнена или неверная сумма.");
	    Ошибки = Ошибки + 1; 
		Продолжить;
	   КонецЕсли;
		НовыйДок = Документы.ПоступлениеПлатежа.СоздатьДокумент();
		НовыйДок.Дата = ДатаПлатежа;
		НовыйДок.Бокс = Стр.Бокс;
		НовыйДок.Собственник = ЭлектроУчет.СобственникБоксаНаДату(Стр.Бокс, ДатаПлатежа);
		НовыйДок.Сумма = Стр.Сумма;
		НовыйДок.СпособПоступления = СпособПоступления;
		НовыйДок.Комментарий = Стр.Комментарий;
		Попытка
			НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
			Создано = Создано + 1;
		Исключение
		   Сообщить("Бокс " + Строка(Стр.Бокс) + ": " + ОписаниеОшибки());
		   Ошибки = Ошибки + 1;
		КонецПопытки;
	КонецЦикла;
	Сообщить("Готово. Создано документов: " + Создано + ". Пропущено/ошибок: " + Ошибки + ".");
КонецПроцедуры

