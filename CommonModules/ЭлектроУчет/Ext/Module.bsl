// Счётчик числится установленным на момент:
// индивидуальный — на боксе, общий — на вводе.
Функция СчетчикВЭксплуатации(Счетчик, Момент) Экспорт
	Если Счетчик.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Счетчик.ТипСчетчика = Перечисления.ТипыСчетчиков.ОбщийПриборУчета Тогда
		Возврат Не ВводСчетчикаНаДату(Счетчик, Момент).Пустая();
	КонецЕсли;
	Возврат Не БоксСчетчикаНаДату(Счетчик, Момент).Пустая();
КонецФункции 

// Дата текущей установки ('00010101' - не установлен / снят).
Функция ДатаТекущейУстановки(Счетчик) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Установки.Период КАК Период
	|ИЗ
	|	РегистрСведений.СчетчикиБоксов.СрезПоследних КАК Установки
	|ГДЕ
	|	Установки.Счетчик = &Счетчик
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Установки.Период
	|ИЗ
	|	РегистрСведений.СчетчикиВводов.СрезПоследних КАК Установки
	|ГДЕ
	|	Установки.Счетчик = &Счетчик";
	
	Запрос.УстановитьПараметр("Счетчик", Счетчик);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Период, '00010101');
КонецФункции

// Какой счётчик числится на вводе на момент времени.
Функция СчетчикВводаНаДату(Ввод, Момент) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
