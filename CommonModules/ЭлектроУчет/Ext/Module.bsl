// Состояния счётчиков на момент: где стоят и последнее показание.
//Возвращает Соответствие: Счетчик -> Структура("Бокс, ВводУстановки, Ввод, Показание").
// У неустановленного - пустые Бокс и Ввод, показание 0.
Функция СостоянияСчетчиков(Счетчики, Момент) Экспорт
Результат = Новый Соответствие;
Если Счетчики.Количество() = 0 Тогда
	Возврат Результат; // с пустым списком
КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Счетчики.Ссылка КАК Счетчик,
		|	ЕСТЬNULL(ТекущиеПоказанияСрезПоследних.Показание, 0) КАК Показание,
		|	ЕСТЬNULL(СчетчикиБоксовСрезПоследних.Бокс, ЗНАЧЕНИЕ(Справочник.ГаражныеБоксы.ПустаяСсылка)) КАК Бокс,
		|	ЕСТЬNULL(СчетчикиВводовСрезПоследних.Ввод, ЗНАЧЕНИЕ(Справочник.ВводыЭлектроснабжения.ПустаяСсылка)) КАК ВводУстановки,
		|   ЕСТЬNULL(СчетчикиБоксовСрезПоследних.Бокс.Ввод, ЕСТЬNULL( СчетчикиВводовСрезПоследних.Ввод,ЗНАЧЕНИЕ(Справочник.ВводыЭлектроснабжения.ПустаяСсылка))) КАК Ввод
		|ИЗ
		|	Справочник.Счетчики КАК Счетчики
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеПоказания.СрезПоследних(&Момент, ) КАК ТекущиеПоказанияСрезПоследних
		|		ПО ТекущиеПоказанияСрезПоследних.Счетчик = Счетчики.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СчетчикиБоксов.СрезПоследних(&Момент, ) КАК СчетчикиБоксовСрезПоследних
		|		ПО СчетчикиБоксовСрезПоследних.Счетчик = Счетчики.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СчетчикиВводов.СрезПоследних(&Момент, ) КАК СчетчикиВводовСрезПоследних
		|		ПО СчетчикиВводовСрезПоследних.Счетчик = Счетчики.Ссылка
		|ГДЕ
		|	Счетчики.Ссылка В (&Счетчики)";
	
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Счетчики", Счетчики);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Счетчик, Новый Структура("Бокс, ВводУстановки, Ввод, Показание", Выборка.Бокс, Выборка.ВводУстановки, Выборка.Ввод, Выборка.Показание));
	КонецЦикла;
	Возврат Результат;
КонецФункции

