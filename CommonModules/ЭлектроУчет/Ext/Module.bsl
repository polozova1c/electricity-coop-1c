Функция ТарифНаДату(Тариф, Момент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЦеныТарифовСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныТарифов.СрезПоследних(&Момент, Тариф = &Тариф) КАК ЦеныТарифовСрезПоследних";
	
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Тариф", Тариф);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Цена, 0);	
	
КонецФункции  

