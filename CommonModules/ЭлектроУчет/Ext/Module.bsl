Функция БоксСчетчикаНаДату(Счетчик, Момент) Экспорт
	//Счетчик - ресурс, поэтому отбор после среза, а не в его параметрах
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СчетчикиБоксовСрезПоследних.Бокс КАК Бокс
	|ИЗ
	|	РегистрСведений.СчетчикиБоксов.СрезПоследних(&Момент, ) КАК СчетчикиБоксовСрезПоследних
	|ГДЕ
	|	СчетчикиБоксовСрезПоследних.Счетчик = &Счетчик
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетчикиБоксовСрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Счетчик", Счетчик);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Бокс, Справочники.ГаражныеБоксы.ПустаяСсылка()); 
КонецФункции 

