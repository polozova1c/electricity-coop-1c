//Есть ли записи показаний по счетчику строго позже момента.
//Записи самого документа (период = Дата документа) не попадают -
//поэтому корректно работает и при перепроведении.
Функция ЕстьПоказанияПосле(Счетчик, Момент) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1 
	|	ТекущиеПоказания.Период Как Период
	|ИЗ
	|	РегистрСведений.ТекущиеПоказания КАК ТекущиеПоказания
	|ГДЕ
	|	ТекущиеПоказания.Счетчик = &Счетчик
	|	И ТекущиеПоказания.Период > &Момент";
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Счетчик", Счетчик);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Есть ли по боксу другие записи установки счетчика на дату.
Функция ЕстьОперацииСБоксомВДату(Бокс, ДатаДок, ТекущийДокумент) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	1
	|ИЗ
	|	РегистрСведений.СчетчикиБоксов КАК СчетчикиБоксов
	|ГДЕ
	|	СчетчикиБоксов.Период = &Дата
	|	И СчетчикиБоксов.Бокс = &Бокс
	|	И СчетчикиБоксов.Регистратор <> &ТекДок";
	Запрос.УстановитьПараметр("Бокс", Бокс);
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ТекДок", ТекущийДокумент);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

//Есть ли по вводу другие записи установки общего счетчика на дату.
Функция ЕстьОперацииСВводомВДату(Ввод, ДатаДок, ТекущийДокумент) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	1 КАК Поле1
	|ИЗ
	|	РегистрСведений.СчетчикиВводов КАК СчетчикиВводов
	|ГДЕ
	|	СчетчикиВводов.Период = &Дата
	|	И СчетчикиВводов.Ввод = &Ввод
	|	И СчетчикиВводов.Регистратор <> &ТекДок";
	Запрос.УстановитьПараметр("Ввод", Ввод);
	Запрос.УстановитьПараметр("Дата", ДатаДок);
	Запрос.УстановитьПараметр("ТекДок", ТекущийДокумент);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Единый расчёт потребления для форм и проведений.
Функция ДельтаПоказаний(Счетчик, Предыдущее, Текущее) Экспорт
	Результат = Новый Структура("Дельта, Успех, Сообщение", 0, Истина, "");
	Если Текущее < Предыдущее Тогда
		Результат.Успех = Ложь;
		Результат.Сообщение = "Текущее показание (" + Текущее + ") меньше предыдущего ("
		+ Предыдущее + "). Электронный счётчик не обнуляется — проверьте ввод"
		+ " или оформите замену счётчика.";
	Иначе
		Результат.Дельта = Текущее - Предыдущее;
		Кт = ?(Счетчик.КоэффициентТрансформации = 0, 1, Счетчик.КоэффициентТрансформации);
		Результат.Дельта = Результат.Дельта * Кт;
	КонецЕсли;
	Возврат Результат;
КонецФункции
