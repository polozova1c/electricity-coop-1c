
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Для каждого Стр Из Долги Цикл
		Если Стр.Бокс.Пустая() Тогда
			Сообщить("Строка " + Стр.НомерСтроки + ": не указан бокс.");
			Отказ = Истина;
		КонецЕсли;
		Если Стр.Сумма = 0 Тогда
			Сообщить("Строка " + Стр.НомерСтроки + ": нулевая сумма – уберите строку.");
			Отказ =Истина;
		КонецЕсли;
		Если Не Стр.Собственник.Пустая() И Стр.Собственник <> ЭлектроУчет.СобственникБоксаНаДату(Стр.Бокс, Дата) Тогда
			Сообщить("Строка " + Стр.НомерСтроки + ": собственник не соответствует владельцу бокса на дату документа.");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Движения.Взаиморасчеты.Записывать = Истина;
	Для каждого Стр Из Долги Цикл
		Движение = Движения.Взаиморасчеты.Добавить();
		Движение.Период = Дата;
		Движение.Бокс = Стр.Бокс;
		Движение.Собственник = ?(Стр.Сумма > 0, ВидДвиженияНакопления.Приход,  //должен
		ВидДвиженияНакопления.Расход);  //переплата (минус на входе)
	    Движение.Сумма = Макс(Стр.Сумма, -Стр.Сумма); // модуль
	КонецЦикла;
КонецПроцедуры


