
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.Показания.Количество() > 0 Тогда
		ТекущийИндекс = 0;
		ПоказатьСтроку();
	Иначе
		Прогресс = "Нажмите ""Заполнить""";	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоказания(Команда)
	Если Объект.Показания.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьЗавершение", ЭтотОбъект); 
		ПоказатьВопрос(Оповещение, "Заполнить заново? Введённые показания будут стёрты.",РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, , )
	Иначе
		ЗаполнитьТаблицуНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьТаблицуНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	Объект.Показания.Очистить();
	Момент = Объект.Дата - 1;	
	Запрос = Новый Запрос;
	    Запрос.Текст = 
    "ВЫБРАТЬ
    |	Счетчики.Ссылка КАК Счетчик,
    |	ЕСТЬNULL(ТекущиеПоказанияСрезПоследних.Показание, 0) КАК Показание,
    |	ЕСТЬNULL(СчетчикиБоксовСрезПоследних.Бокс.Код, ЕСТЬNULL(СчетчикиВводовСрезПоследних.Ввод.Код, """")) КАК КодМеста,
    |	Счетчики.ТипСчетчика КАК ТипСчетчика
    |ИЗ
    |	Справочник.Счетчики КАК Счетчики
    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеПоказания.СрезПоследних(&Момент) КАК ТекущиеПоказанияСрезПоследних
    |		ПО ТекущиеПоказанияСрезПоследних.Счетчик = Счетчики.Ссылка
    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СчетчикиБоксов.СрезПоследних(&Момент) КАК СчетчикиБоксовСрезПоследних
    |		ПО СчетчикиБоксовСрезПоследних.Счетчик = Счетчики.Ссылка
    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СчетчикиВводов.СрезПоследних(&Момент) КАК СчетчикиВводовСрезПоследних
    |		ПО СчетчикиВводовСрезПоследних.Счетчик = Счетчики.Ссылка
    |ГДЕ
    |	НЕ Счетчики.ПометкаУдаления
    |	И (СчетчикиБоксовСрезПоследних.Счетчик ЕСТЬ НЕ NULL
    |		ИЛИ СчетчикиВводовСрезПоследних.Счетчик ЕСТЬ НЕ NULL)
    |
    |УПОРЯДОЧИТЬ ПО
    |	ТипСчетчика УБЫВ,
    |	КодМеста,
    |	Счетчики.Код";
	
	Запрос.УстановитьПараметр("Момент", Момент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Стр = Объект.Показания.Добавить();
		Стр.Счетчик = Выборка.Счетчик;
		Стр.ПредыдущееПоказание = Выборка.Показание;
		Стр.Показание = Выборка.Показание;
	КонецЦикла;
	Если Объект.Показания.Количество() = 0 Тогда
        Прогресс = "Нет установленных счётчиков на дату документа.";
        Возврат;
    КонецЕсли;
	ТекущийИндекс = 0;
	ПоказатьСтроку();
КонецПроцедуры

&НаКлиенте
Процедура Следующий(Команда)
	ПерейтиНаСервере(1);
КонецПроцедуры

&НаКлиенте
Процедура Предыдущий(Команда)
	ПерейтиНаСервере(-1);
КонецПроцедуры 

&НаСервере
Процедура ПерейтиНаСервере(Смещение)
	Кол = Объект.Показания.Количество();
	Если Кол = 0 Тогда
		Возврат;
	КонецЕсли;  
	СохранитьВвод();
	ТекущийИндекс = Мин(Макс(ТекущийИндекс + Смещение, 0), Кол - 1);
	ПоказатьСтроку();
КонецПроцедуры

&НаСервере
Процедура СохранитьВвод() 
	Если ТекущееПоказание = Неопределено Тогда
        Возврат;
    КонецЕсли;
	Кол = Объект.Показания.Количество();
	Если ТекущийИндекс >= 0 И ТекущийИндекс < Кол Тогда
		Стр = Объект.Показания[ТекущийИндекс];
		Стр.Показание = ТекущееПоказание;
		Расчет = ЭлектроУчет.ДельтаПоказаний(Стр.Счетчик, Стр.ПредыдущееПоказание, ТекущееПоказание);
		Стр.ПотреблениеКвт = ?(Расчет.Успех, Расчет.Дельта, 0);
		Если Не Расчет.Успех Тогда
			Сообщить("Счётчик " + Строка(Стр.Счетчик) + ": " + Расчет.Сообщение);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПоказатьСтроку()
	Стр = Объект.Показания[ТекущийИндекс];
	ТекущийСчетчик = Стр.Счетчик;
	ТекущееПредыдущее = Стр.ПредыдущееПоказание;
	ТекущееПоказание = Стр.Показание;
	ТекущееПотребление = Стр.ПотреблениеКвт;
	ЭтоОбщийСчетчик = Стр.Счетчик.ТипСчетчика = Перечисления.ТипыСчетчиков.ОбщийПриборУчета;
	Прогресс = ?(ЭтоОбщийСчетчик, "ВВОДНЫЙ СЧЁТЧИК (" + (ТекущийИндекс + 1) + " из " + Объект.Показания.Количество() + ")",
	"Счётчик " + (ТекущийИндекс + 1) + " из " + Объект.Показания.Количество());
КонецПроцедуры


&НаКлиенте
Процедура ТекущееПоказаниеПриИзменении(Элемент)
	Если ТекущееПоказание = Неопределено Тогда
        Возврат;
	КонецЕсли;
	ТекущееПотребление = Макс(ТекущееПоказание - ТекущееПредыдущее, 0);
	Если ТекущееПоказание < ТекущееПредыдущее Тогда
		Оповещение = Новый ОписаниеОповещения("ПредупреждениеЗавершение", ЭтотОбъект);
		ПоказатьПредупреждение(Оповещение, "Показание меньше предыдущего - проверьте цифры.");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПредупреждениеЗавершение(ДополнительныеПараметры) Экспорт
	// Продолжение после закрытия предупреждения - действий не требуется.
	ТекущийЭлемент = Элементы.ТекущееПоказание; // вернуть ввод на поле показания
КонецПроцедуры 

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ПараметрыЗаписи.Свойство("СпросилиПустыеПоказания") Тогда
		Возврат; // уже ответили "Да"  
	КонецЕсли;
	Если Не ПараметрыЗаписи.Свойство("Проведение") Тогда
		Возврат;
	КонецЕсли;
	БезПоказаний = 0;
	Примеры = "";
	Для каждого Стр Из Объект.Показания Цикл
		Если Стр.Счетчик.Пустая() Тогда
			Продолжить;
		КонецЕсли; 
		Если Стр.Показание = Стр.ПредыдущееПоказание Тогда
			БезПоказаний = БезПоказаний + 1;
			Если БезПоказаний <= 3 Тогда
				Примеры = Примеры + ?(Примеры = "", "", ",") + Строка(Стр.Счетчик);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	Если БезПоказаний = 0 Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	ПараметрыЗаписи.Вставить("СпросилиПустыеПоказания", Истина);
	Текст = "По " + БезПоказаний + " счётчикам не введены новые показания (потребление" + " по ним будет нулевым)."
	+ ?(Примеры = "", "", Символы.ПС + "Например: " + Примеры + ? (БезПоказаний > 3, " и др.", "") + ".")
	+ Символы.ПС + "Провести документ?";
	Оповещение = Новый ОписаниеОповещения("ПровестиПослеВопросаЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, 0, , КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаСервере
