
&НаКлиенте
Процедура ЗаполнитьПоказания(Команда)
	Если Объект.Показания.Количество() > 0
		И Вопрос("Заполнить зановво? Введённые показания будут стёрты.",
		РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
	    Возврат;	
	КонецЕсли;
	ЗаполнитьПоказанияНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоказанияНаСервере()
	Объект.Показания.Очистить();
	Момент = Объект.Дата - 1;	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Счетчики.Ссылка КАК Счетчик,
	|	ЕСТЬNULL(ТекущиеПоказанияСрезПоследних.Показание, 0) КАК Показание,
	|	ЕСТЬNULL(СчетчикиБоксовСрезПоследних.Бокс.Код, ЕСТЬNULL(СчетчикиВводовСрезПоследних.Ввод.Код, """")) КАК КодМеста,
	|	Счетчики.ТипСчетчика КАК ТипСчетчика
	|ИЗ
	|	РегистрСведений.СчетчикиВводов.СрезПоследних КАК СчетчикиВводовСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Счетчики КАК Счетчики
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеПоказания.СрезПоследних(&Момент, ) КАК ТекущиеПоказанияСрезПоследних
	|			ПО (ТекущиеПоказанияСрезПоследних.Счетчик = Счетчики.Ссылка)
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СчетчикиБоксов.СрезПоследних(&Момент, ) КАК СчетчикиБоксовСрезПоследних
	|			ПО (СчетчикиБоксовСрезПоследних.Счетчик = Счетчики.Ссылка)
	|		ПО СчетчикиВводовСрезПоследних.Счетчик = Счетчики.Ссылка
	|ГДЕ
	|	НЕ Счетчики.ПометкаУдаления
	|	И (СчетчикиБоксовСрезПоследних.Счетчик ЕСТЬ НЕ NULL 
	|			ИЛИ СчетчикиВводовСрезПоследних.Счетчик ЕСТЬ НЕ NULL )
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТипСчетчика УБЫВ,
	|	КодМеста,
	|	Счетчики.Код";
	
	Запрос.УстановитьПараметр("Момент", Момент);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Объект.Показания.Добавить();
		Стр.Счетчик = Выборка.Счетчик;
		Стр.ПредыдущееПоказание = Выборка.Показание;
		Стр.Показание = Выборка.Показание;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ЭлементОформления = УсловноеОформление.Элементы.Добавить();
    ЭлементОформления.Использование = Истина;

    // Где подсвечиваем: вся строка таблицы
    Поле = ЭлементОформления.Поля.Элементы.Добавить();
    Поле.Поле = Новый ПолеКомпоновкиДанных("Показания");

    // Когда подсвечиваем: Показание = ПредыдущееПоказание
    Условие = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    Условие.Использование = Истина;
    Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Показания.Показание");
    Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Показания.ПредыдущееПоказание");

    // Как подсвечиваем: мягкий лимонный фон
    ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 250, 205));
КонецПроцедуры
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
    // Спрашиваем только при проведении, не при простой записи
    Если НЕ ПараметрыЗаписи.Свойство("Проведение") Тогда
        Возврат;
    КонецЕсли;

    БезПоказаний = 0;
    Примеры = "";
    Для Каждого Стр Из Объект.Показания Цикл
        Если Стр.Счетчик.Пустая() Тогда
            Продолжить;
        КонецЕсли;
        Если Стр.Показание = Стр.ПредыдущееПоказание Тогда // те же строки, что подсвечены
            БезПоказаний = БезПоказаний + 1;
            Если БезПоказаний <= 3 Тогда
                Примеры = Примеры + ?(Примеры = "", "", ", ") + Строка(Стр.Счетчик);
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Если БезПоказаний = 0 Тогда
        Возврат;
    КонецЕсли;

    ТекстВопроса = "По " + БезПоказаний + " счётчикам не введены новые показания"
        + " (потребление по ним будет нулевым)."
        + ?(Примеры = "", "", Символы.ПС + "Например: " + Примеры
            + ?(БезПоказаний > 3, " и др.", "") + ".")
        + Символы.ПС + "Провести документ?";

    Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Отказ = Истина; // запись отменена, документ остался непроведённым
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияПоказаниеПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Показания.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
	   Возврат;
	КонецЕсли;
	Результат = ПересчитатьСтрокуНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
	Если ЗначениеЗаполнено(Результат.Сообщение) Тогда
	    ПоказатьПредупреждение(, Результат.Сообщение);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПересчитатьСтрокуНаСервере(ИдентификаторСтроки)
	Результат = Новый Структура("Сообщение", "");
	Стр = Объект.Показания.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Стр = Неопределено Или Стр.Счетчик.Пустая() Тогда
	   Возврат Результат;	
   КонецЕсли; 
   Если Не ЗначениеЗаполнено(Стр.ПредыдущееПоказание) Тогда
       Стр.ПредыдущееПоказание = ЭлектроУчет.ТекущееПоказаниеЧисло(Стр.Счетчик, Объект.Дата - 1);   
   КонецЕсли;
   Расчет = ЭлектроУчет.ДельтаПоказаний(Стр.Счетчик, Стр.ПредыдущееПоказание, Стр.Показание);
   Если Расчет.Успех Тогда
      Стр.ПотреблениеКвт = Расчет.Дельта;
  Иначе
	  Стр.ПотреблениеКвт = 0;
	  Результат.Сообщение = "Счётчик " + Строка(Стр.Счетчик) + ": " + Расчет.Сообщение;   
  КонецЕсли;
  Возврат Результат;
КонецФункции

