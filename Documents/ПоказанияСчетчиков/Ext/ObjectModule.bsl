  Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	  СчетчикиВДокументе = Новый Массив;
	  Для каждого Стр Из Показания Цикл
		  Если Стр.Счетчик.Пустая() Тогда
			  Продолжить;		
		  КонецЕсли;
		  Если СчетчикиВДокументе.Найти(Стр.Счетчик) <> Неопределено Тогда
			  Сообщить("Счётчик " + Строка(Стр.Счетчик) + " встречается в таблице дважды.");
			  Отказ = Истина;
		  Иначе
			  СчетчикиВДокументе.Добавить(Стр.Счетчик);
		  КонецЕсли;
		  Если Стр.Показание < 0 Тогда
			  Сообщить("Строка " + Стр.НомерСтроки + ": показание не может быть отрицательным.");
			  Отказ = Истина;
		  КонецЕсли;
	  КонецЦикла;
  КонецПроцедуры
  
  Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	  Движения.ПотреблениеЭлектроэнергии.Записывать = Истина;
	  Движения.ТекущиеПоказания.Записывать = Истина;
	  МоментДо = Дата - 1;
	  
	  СписокСчетчиков = Новый Массив;
	  Для каждого Стр Из Показания Цикл
		  Если Не Стр.Счетчик.Пустая() И СписокСчетчиков.Найти(Стр.Счетчик) = Неопределено Тогда
			  СписокСчетчиков.Добавить(Стр.Счетчик);	  
		  КонецЕсли;
	  КонецЦикла;
	  Состояния = ЭлектроУчет.СостоянияСчетчиков(СписокСчетчиков, МоментДо);
	  Для Каждого Стр Из Показания Цикл
		  Если Стр.Счетчик.Пустая() Тогда 
			  Продолжить;
		  КонецЕсли;
		  Состояние = Состояния.Получить(Стр.Счетчик);
		  Если Состояние = Неопределено Тогда
			  Продолжить; 
		  КонецЕсли;
		  
		  ЭтоОбщий = Стр.Счетчик.ТипСчетчика = Перечисления.ТипыСчетчиков.ОбщийПриборУчета;
		  // --- где стоит счётчик ---
		  Если ЭтоОбщий Тогда
			  Если Состояние.ВводУстановки.Пустая() Тогда
				  Сообщить("Общий счётчик " + Строка(Стр.Счетчик) + " не числится установленным на вводе - показания по нему не вводятся.");
				  Отказ = Истина;
				  Продолжить;
			  КонецЕсли;
		  Иначе
			  Если Состояние.Бокс.Пустая() Тогда
				  Сообщить("Индивидуальный счётчик " + Строка(Стр.Счетчик) + " не привязан к боксу - оформите установку.");
				  Отказ = Истина;
				  Продолжить;
			  КонецЕсли;
		  КонецЕсли;
		  // --- предыдущее показание из регистра на МоментДо ---
		  Стр.ПредыдущееПоказание = Состояние.Показание;	
		  
		  Расчет = ЭлектроУчет.ДельтаПоказаний(Стр.Счетчик, Стр.ПредыдущееПоказание, Стр.Показание);
		  Если Не Расчет.Успех Тогда
			  Сообщить("Счётчик " + Строка(Стр.Счетчик) + ": " + Расчет.Сообщение);
			  Отказ = Истина;
			  Продолжить;
		  КонецЕсли;
		  Если ЗначениеЗаполнено(Стр.Счетчик.ДатаСледующейПоверки)
			  И Стр.Счетчик.ДатаСледующейПоверки < Дата Тогда
			  Сообщить("ВНИМАНИЕ: поверка счетчика " + Строка(Стр.Счетчик)
			  + " просрочена (срок " + Формат(Стр.Счетчик.ДатаСледующейПоверки,"ДЛФ=D") + ").");
		  КонецЕсли;
		  Если Расчет.Дельта > 0 Тогда
			  Движение = Движения.ПотреблениеЭлектроэнергии.Добавить();
			  Движение.Период = Дата;
			  Движение.Счетчик = Стр.Счетчик;
			  Движение.ТипСчетчика = Стр.Счетчик.ТипСчетчика;
			  Движение.КвтЧ = Расчет.Дельта;
			  Движение.Ввод = Состояние.Ввод;
			  Если Не ЭтоОбщий Тогда
				  Движение.Бокс = Состояние.Бокс;
			  КонецЕсли;
		  КонецЕсли;
		  
		  Движение2 = Движения.ТекущиеПоказания.Добавить();
		  Движение2.Период = Дата;
		  Движение2.Счетчик = Стр.Счетчик;
		  Движение2.Показание = Стр.Показание;
	  КонецЦикла;
  КонецПроцедуры 
  
  
  