 &НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |	РасчетыСЭлектросетьюОстатки.Ввод КАК Ввод,
    |	РасчетыСЭлектросетьюОстатки.СуммаОстаток КАК Долг
    |ИЗ
    |	РегистрНакопления.РасчетыСЭлектросетью.Остатки(, ) КАК РасчетыСЭлектросетьюОстатки
    |ГДЕ
    |	РасчетыСЭлектросетьюОстатки.СуммаОстаток > 0
    |УПОРЯДОЧИТЬ ПО
    |	Долг УБЫВ";
    Выборка = Запрос.Выполнить().Выбрать();
    Если Объект.Ввод.Пустая() И Выборка.Следующий() Тогда
        Объект.Ввод = Выборка.Ввод;
        Если Выборка.Следующий() Тогда
            Сообщить("Долг перед сетью есть по нескольким вводам —"
                + " подставлен ввод с наибольшим долгом, проверьте.");
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВводПриИзмененииНаСервере()
	Если Объект.Ввод.Пустая() Тогда
	    ДолгПоВводу = 0;
		Возврат;	
	КонецЕсли;
	ДолгПоВводу = ЭлектроУчет.ДолгСетиПоВводу(Объект.Ввод, Объект.Дата-1);
КонецПроцедуры

&НаКлиенте
Процедура ВводПриИзменении(Элемент)
	ВводПриИзмененииНаСервере();
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьСуммуПоДолгу(Команда)
    ЗаполнитьСуммуПоДолгуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСуммуПоДолгуНаСервере()
	Если Объект.Ввод.Пустая() Тогда
        Сообщить("Сначала укажите ввод.");
        Возврат;
    КонецЕсли;
    Объект.Сумма = ЭлектроУчет.ДолгСетиПоВводу(Объект.Ввод, Объект.Дата - 1);
    Если Объект.Сумма <= 0 Тогда
        Сообщить("По этому вводу долга перед сетью нет.");
	КонецЕсли;
КонецПроцедуры
