 Функция ПечатьКвитанций(ДокСсылка) Экспорт
	 ДокОбъект = ДокСсылка.ПолучитьОбъект();
	 Макет = ДокОбъект.ПолучитьМакет("Квитанция");
	 ТабДок = Новый ТабличныйДокумент;
	 ОблШапка  = Макет.ПолучитьОбласть("Шапка");
	 ОблНачисления = Макет.ПолучитьОбласть("СтрокаНачисления");
	 ОблОДН = Макет.ПолучитьОбласть("СтрокаОДН");
	 ОблИтог = Макет.ПолучитьОбласть("СтрокаИтог");
	 ОблИтого   = Макет.ПолучитьОбласть("Итог");
	 
	 //предрасчёты по вводам: потери на бокс (для информационной строки)
	 ПотериПоВВодам = Новый Соответствие;
	 Для Каждого Стр Из ДокСсылка.Начисления Цикл 
		 Если Не ПотериПоВВодам.Получить(Стр.Ввод)= Неопределено и Не Стр.Ввод.Пустая() Тогда
			 Коэф = Стр.Ввод.КоэффициентПотерь;
			 Если Коэф <= 0 Тогда
				 Коэф = 1;
			 КонецЕсли;
			 //физический расход ввода = учётный / коэф (обратный пересчёт)
			 Физич = ДокСсылка.ОбщееПотреблениеУчетноеКвт / Коэф;
			 ПотериПоВВодам.Вставить(Стр.Ввод, Окр(Физич * (Коэф - 1), 3, РежимОкругления.Окр15как20)); 
		 КонецЕсли;
	 КонецЦикла;
	 // потери на бокс
	 КолСтрок = ДокСсылка.Начисления.Количество();
	 Для каждого Стр Из ДокСсылка.Начисления Цикл	
		 // Долг до этого начисления (включая платежи текущего месяца)
		 Долг = ЭлектроУчет.ЗадолженностьБоксаНаДату(Стр.Бокс, ДокСсылка.Дата - 1);
		 
		 ОблШапка.Параметры.Период = Формат(ДокСсылка.Период, "ДФ='ММММ yyyy'");
		 ОблШапка.Параметры.Бокс = Строка(Стр.Бокс);
		 ОблШапка.Параметры.Собственник = Строка(Стр.Собственник);
		 ТабДок.Вывести(ОблШапка);
		 // показания бокса: из последнего документа показаний ( по ТЧ не хранятся - берём из РС)
		 ТекПоказ = ЭлектроУчет.ТекущееПоказаниеЧисло(СчетчикБокса(Стр.Бокс, ДокСсылка.Период),КонецМесяца(ДокСсылка.Период));
		 ПредПоказ = ЭлектроУчет.ТекущееПоказаниеЧисло(СчетчикБокса(Стр.Бокс, ДокСсылка.Период), НачалоМесяца(ДокСсылка.Период) - 1);
		 // заполнение облБаза
		 ОблНачисления.Параметры.Показания = ?(ПредПоказ = 0, "", Строка(ПредПоказ) + " / ") + Строка(ТекПоказ);
		 ОблНачисления.Параметры.КвтИнд = Стр.КвтИндивидуально;
		 ОблНачисления.Параметры.Тариф = Стр.ТарифПримененный; 
		 ОблНачисления.Параметры.СуммаИнд = Стр.СуммаИндивидуально;
		 
		 ТабДок.Вывести(ОблНачисления);
		 // строки ОДН - только при способе "поровну"
		 Если ДокСсылка.СпособРаспределения = Перечисления.СпособыРаспределенияПерерасхода.ПоровнуНаБоксы Тогда
			 ОблОДН.Параметры.КвтОДН = Стр.КвтОДН;
			 ПотериВвода = ПотериПоВводам.Получить(Стр.Ввод);
			 ОблОДН.Параметры.ПотериСети = ?(ПотериВвода = Неопределено Или КолСтрок = 0, 0,
			 Окр(ПотериВвода / КолСтрок, 1, РежимОкругления.Окр15как20)); //доля на бокс, инфо
			 ОблОДН.Параметры.СуммаОДН = Стр.СуммаОДН;
			 ТабДок.Вывести(ОблОДН);
		 КонецЕсли;
		 ОблИтог.Параметры.СуммаСтроки = Стр.СуммаИтого;
		 ТабДок.Вывести(ОблИтог);
		 
		 ОблИтого.Параметры.Долг = Долг;
		 ОблИтого.Параметры.КОплате = Долг + Стр.СуммаИтого; 
		 ОблИтого.Параметры.ДатаОплаты = Формат(КонецМесяца(ДокСсылка.Период)+ 10*24*60*60, "ДЛФ=D"); // +10 дней
		 ТабДок.Вывести(ОблИтого);
		 ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
	 КонецЦикла;
	 Возврат ТабДок;
 КонецФункции 
 Функция СчетчикБокса(Бокс, Момент)
	 Возврат ЭлектроУчет.СчетчикБоксаНаДату(Бокс, Момент);
 КонецФункции
