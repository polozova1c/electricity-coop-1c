&НаКлиенте
Процедура РассчитатьНачисление(Команда)
    Если Объект.Начисления.Количество() > 0
        И Вопрос("Пересчитать? Текущие строки будут заменены.",
            РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    РассчитатьНачислениеНаСервере();
КонецПроцедуры

&НаСервере
Процедура РассчитатьНачислениеНаСервере()
    ДокОбъект = РеквизитФормыВЗначение("Объект");
    ДокОбъект.ЗаполнитьИРассчитать();
    ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ПечатьКвитанций(Команда)
    Если Объект.Ссылка.Пустая() Тогда
        Оповещение = Новый ОписаниеОповещения("ПечатьПослеВопросаЗаписи", ЭтотОбъект);
        ПоказатьВопрос(Оповещение, "Документ ещё не записан. Записать и напечатать квитанции?",
            РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
        Возврат;
    КонецЕсли;
    НапечататьКвитанции();
КонецПроцедуры

&НаКлиенте
Процедура ПечатьПослеВопросаЗаписи(РезультатВопроса, ДополнительныеПараметры) Экспорт
    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    Записать(Новый ОписаниеОповещения("ПечатьПослеЗаписи", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура ПечатьПослеЗаписи(ДополнительныеПараметры) Экспорт
    Если Объект.Ссылка.Пустая() Тогда
        Возврат; // запись сорвалась — сообщения уже показаны платформой
    КонецЕсли;
    НапечататьКвитанции();
КонецПроцедуры

&НаКлиенте
Процедура НапечататьКвитанции()
    ТабДок = ПечатьКвитанцийНаСервере();
    ТабДок.Показать("Квитанции");
КонецПроцедуры

&НаСервере
Функция ПечатьКвитанцийНаСервере()
    Возврат Документы.НачислениеЭлектроэнергии.ПечатьКвитанций(Объект.Ссылка);
КонецФункции